<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="0,0,10,12">
    <ui:InfoBar x:Name="HomeNotice" IsOpen="False" IsClosable="False" Severity="Informational" Margin="0,0,0,10" Title="" Message="" />

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
      <StackPanel>
        <TextBlock Text="STORE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="StoreCombo" Grid.Column="0" IsEditable="True" HorizontalAlignment="Stretch" AutomationProperties.Name="Store folder" />
          <ui:Button x:Name="StoreBrowse" Grid.Column="1" Content="Choose a folder..." Margin="8,0,0,0" AutomationProperties.Name="Choose the store folder" />
          <ui:Button x:Name="StoreRefresh" Grid.Column="2" Content="Check again" Margin="8,0,0,0" AutomationProperties.Name="Read the store again" />
        </Grid>
        <TextBlock x:Name="StoreInfo" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <WrapPanel x:Name="StatTiles" Margin="0,10,0,0" />
        <Grid Margin="0,2,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Configuration" Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
          <TextBox x:Name="SetConfigPath" Grid.Column="1" Margin="10,0,8,0" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Configuration file" />
          <ui:Button x:Name="SetConfigBrowse" Grid.Column="2" Content="Browse..." />
          <ui:Button x:Name="SetConfigReload" Grid.Column="3" Content="Reload" Margin="8,0,0,0" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <ui:Button x:Name="SetLocalOpen" Content="Open the local override" Margin="0,0,8,0" />
          <ui:Button x:Name="SetLogOpen" Content="Open the log folder" Margin="0,0,8,0" />
          <ui:Button x:Name="SetOutOpen" Content="Open the reports folder" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="10" Padding="18,14" AutomationProperties.Name="Source tenant">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="SourceLight" Width="14" Height="14" Fill="{DynamicResource TmtTrack}" VerticalAlignment="Center" />
            <TextBlock Text="SOURCE TENANT" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <TextBlock x:Name="SourceInfo" Margin="24,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock x:Name="SourceState" Margin="24,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <Expander Header="Permissions" Margin="24,8,0,0">
            <StackPanel x:Name="SourceRoles" Margin="0,6,0,0" />
          </Expander>
          <ui:Button x:Name="SourceCheck" Content="Check permissions" Margin="24,10,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Check the source permissions" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="10" Padding="18,14" AutomationProperties.Name="Target tenant">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="TargetLight" Width="14" Height="14" Fill="{DynamicResource TmtTrack}" VerticalAlignment="Center" />
            <TextBlock Text="TARGET TENANT" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <TextBlock x:Name="TargetInfo" Margin="24,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock x:Name="TargetState" Margin="24,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <Expander Header="Permissions" Margin="24,8,0,0">
            <StackPanel x:Name="TargetRoles" Margin="0,6,0,0" />
          </Expander>
          <ui:Button x:Name="TargetCheck" Content="Check permissions" Margin="24,10,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Check the target permissions" />
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</ScrollViewer>
