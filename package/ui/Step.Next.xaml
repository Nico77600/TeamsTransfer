<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="0,0,10,12">
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="NextLight" Width="16" Height="16" Fill="{DynamicResource TmtTrack}" VerticalAlignment="Center" />
          <TextBlock x:Name="NextTitle" Text="" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </StackPanel>
        <TextBlock x:Name="NextText" Margin="26,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <WrapPanel x:Name="NextKpis" Margin="0,12,0,0" />
        <TextBlock x:Name="NextFailure" Margin="26,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TmtCritical}" />
      </StackPanel>
    </Border>

    <Border Margin="0,12,0,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
      <StackPanel>
        <TextBlock Text="What to do next" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock x:Name="NextAdvice" TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <WrapPanel x:Name="NextButtons" />
      </StackPanel>
    </Border>

    <Border Margin="0,12,0,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
      <StackPanel>
        <TextBlock Text="The same from the command line" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Text="Every console run is an ordinary command: copy it to a script or a scheduled task." Margin="0,2,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <StackPanel x:Name="NextCommands" />
      </StackPanel>
    </Border>

    <Border Margin="0,12,0,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
      <StackPanel>
        <TextBlock Text="Reports" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <WrapPanel x:Name="NextLinks" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
  </StackPanel>
</ScrollViewer>
